# Porta em que a API escuta
PORT=3333

# Ambiente: development | production | test
NODE_ENV=development

# String de conexão do PostgreSQL (Supabase ou local)
DATABASE_URL=postgres://usuario:senha@localhost:5432/abastecemais

# Origem do front-end permitida no CORS
CORS_ORIGIN=http://localhost:5173

# (Opcional) Caminho para a pasta de migrations, se diferente do padrão
# MIGRATIONS_DIR=../database/migrations
